    70
   ],
   "size": [
    900,
    116
   ],
   "flags": {},
   "order": 14,
   "mode": 0,
   "inputs": [],
   "outputs": [],
   "properties": {},
   "widgets_values": [
    "image_prompts is a list, so CLIP Text Encode, KSampler and VAE Decode run once per shot.\nModel: models/checkpoints/juggernautXL_juggXIByRundiffusion.safetensors (Juggernaut XL, RunDiffusion). Any SDXL checkpoint works; keep 1344x768 for 16:9."
   ],
   "color": "#432",
   "bgcolor": "#653",
   "title": "Note: 2 · Keyframes (one image per shot)"
  },
  {
   "id": 16,
   "type": "Note",
