   "inputs": [],
   "outputs": [],
   "properties": {},
   "widgets_values": [
    "Shot Animatic times every keyframe from the shot list and adds the camera move named in each shot (push-in, pan, tilt...) as a smooth Ken Burns move, with crossfades. No model needed. Save Video writes an MP4 to output/ShotPlanner/."
   ],
   "color": "#432",
   "bgcolor": "#653",
   "title": "Note: 3 · Animatic"
  }
