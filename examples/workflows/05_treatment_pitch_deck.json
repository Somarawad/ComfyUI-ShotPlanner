    "{\n  \"title\": \"NOVARA - Every morning, Milano\",\n  \"style\": \"cinematic commercial, photoreal, warm morning light, 35mm\",\n  \"shots\": [\n    {\n      \"id\": 1,\n      \"description\": \"The barista pulls an espresso shot; thick golden crema rises in the cup.\",\n      \"camera\": \"slow dolly push-in\",\n      \"duration\": 3,\n      \"image_prompt\": \"Close-up of an espresso machine spout pouring golden espresso into a small cup, warm morning window light, Milan cafe, 35mm, photoreal\",\n      \"video_prompt\": \"Thick golden espresso pours steadily, crema swirls and rises, steam curls, slow dolly push-in\"\n    },\n    {\n      \"id\": 2,\n      \"description\": \"She hands the white NOVARA paper cup across the counter to a young woman in a camel coat.\",\n      \"camera\": \"gentle handheld\",\n      \"duration\": 3.5,\n      \"image_prompt\": \"A barista with dark hair in a bun and a black apron hands a white paper cup printed NOVARA to a young woman in a camel coat across a cafe counter, warm light\",\n      \"video_prompt\": \"The barista hands the cup across the counter, the woman takes it with both hands and smiles, gentle handheld\"\n    },\n    {\n      \"id\": 3,\n      \"description\": \"The customer takes the first sip at the window and smiles.\",\n      \"camera\": \"subtle slow push-in\",\n      \"duration\": 3,\n      \"image_prompt\": \"A young woman with brown wavy hair in a camel coat sips from a white NOVARA paper cup by a cafe window, soft morning light\",\n      \"video_prompt\": \"She slowly sips, lowers the cup and smiles warmly, subtle slow push-in\"\n    },\n    {\n      \"id\": 4,\n      \"description\": \"She walks out into the sunny Milan street holding the cup.\",\n      \"camera\": \"smooth backward tracking shot\",\n      \"duration\": 3.5,\n      \"image_prompt\": \"A young woman in a camel coat walks along a sunny Milan street holding a white NOVARA paper cup, people in the background\",\n      \"video_prompt\": \"Sh